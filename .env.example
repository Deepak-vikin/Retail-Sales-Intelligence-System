DATABASE_URL=postgresql://user:password@localhost:5432/postgres
OPENROUTER_API_KEY=your_openrouter_api_key_here
SUPABASE_PROJECT_NAME=your_project_name
SUPABASE_PASSWORD=your_supabase_password

# Supabase Auth Configuration (ES256 Asymmetric via JWKS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# First-Owner Bootstrap Secret (MUST be distinct from SUPABASE_SERVICE_ROLE_KEY)
# Generate a high-entropy secret using: openssl rand -hex 32
# Remove or leave empty after initial store owner creation is completed.
BOOTSTRAP_SECRET=your_secure_random_bootstrap_secret_here

# Optional Legacy configuration (only required if accepting older symmetric HS256 tokens)
# SUPABASE_JWT_SECRET=your_legacy_supabase_jwt_secret_here

PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODEL_2=google/gemma-4-31b-it:free
FALLBACK_MODEL_3=nvidia/nemotron-3.5-lightning:free
